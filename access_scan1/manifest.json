{
  "manifest_version": 3,
  "name": "access scan1",
  "version": "1.0.0",
  "description": "access scan1 — Universal Single-Switch & Multi-Input Browser Assistant with Hierarchical Scanning, Auditory Cues, Floating Dock, and On-Screen Keyboard.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "access scan1 Controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
